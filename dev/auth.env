# Local development values for forgerealm-auth with the mock Patreon (AUTH-3).
# Dev-only secrets; production reads Secret Manager. Hosts match
# dev/docker-compose.yml: the browser reaches auth at localhost:3099 and the
# mock at localhost:8090; auth reaches the mock at mock-patreon:8090.
DATABASE_URL=postgres://forgerealm:forgerealm@auth-db:5432/forgerealm_auth?sslmode=disable
PORT=8080

# Shared with AtlasForge's local compose, so its API accepts these tokens.
JWT_SECRET_CURRENT=atlasforge-local-dev-secret-hs256
ADMIN_JWT_SECRET=atlasforge-local-admin-secret-hs256
WEB_HOOK_SECRET=local-dev-webhook-secret

# Must match the mock's PATREON_CLIENT_ID and PATREON_CLIENT_SECRET.
PATREON_CLIENT_ID=mock-client-id
PATREON_CLIENT_SECRET=mock-client-secret

PATREON_REDIRECT_URL=http://localhost:3099/auth/callback
PATREON_AUTHORIZE_URL=http://localhost:8090/oauth2/authorize
PATREON_TOKEN_URL=http://mock-patreon:8090/api/oauth2/token
PATREON_API_BASE=http://mock-patreon:8090

# Where /auth/login?app=atlasforge lands after login: AtlasForge's local UI.
ATLASFORGE_CALLBACK_URL=http://localhost:5173/auth/callback
